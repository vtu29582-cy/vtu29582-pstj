import java.io.*;
import java.util.*;

public class Solution {

    static int[] radius;
    static int[][] sparse;
    static int[] log;

    // Manacher's algorithm
    static void manacher(char[] a) {

        int n = a.length;
        radius = new int[n];

        int center = 0;
        int right = 0;

        for (int i = 0; i < n; i++) {

            int mirror = 2 * center - i;

            if (i < right) {
                radius[i] = Math.min(right - i, radius[mirror]);
            } else {
                radius[i] = 0;
            }

            while (i - radius[i] - 1 >= 0 &&
                   i + radius[i] + 1 < n &&
                   a[i - radius[i] - 1] == a[i + radius[i] + 1]) {

                radius[i]++;
            }

            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }
    }

    // Build Sparse Table
    static void buildSparse() {

        int n = radius.length;

        log = new int[n + 1];

        for (int i = 2; i <= n; i++) {
            log[i] = log[i / 2] + 1;
        }

        int levels = log[n] + 1;

        sparse = new int[levels][n];

        for (int i = 0; i < n; i++) {
            sparse[0][i] = radius[i];
        }

        for (int k = 1; k < levels; k++) {

            int len = 1 << k;

            for (int i = 0; i + len <= n; i++) {

                sparse[k][i] = Math.max(
                        sparse[k - 1][i],
                        sparse[k - 1][i + (len >> 1)]
                );
            }
        }
    }

    // Range Maximum Query
    static int query(int left, int right) {

        if (left > right) {
            return 0;
        }

        int length = right - left + 1;
        int k = log[length];

        return Math.max(
                sparse[k][left],
                sparse[k][right - (1 << k) + 1]
        );
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br = new BufferedReader(
                new InputStreamReader(System.in)
        );

        int n = Integer.parseInt(br.readLine().trim());

        String s = br.readLine().trim();

        // Create s + s
        String doubled = s + s;

        /*
         * Transform:
         *
         * abc -> #a#b#c#
         *
         * This allows odd and even length palindromes
         * to be handled in the same way.
         */
        int m = doubled.length() * 2 + 1;

        char[] transformed = new char[m];

        for (int i = 0; i < m; i++) {

            if (i % 2 == 0) {
                transformed[i] = '#';
            } else {
                transformed[i] = doubled.charAt(i / 2);
            }
        }

        // Manacher
        manacher(transformed);

        // Sparse table for maximum radius
        buildSparse();

        StringBuilder answer = new StringBuilder();

        /*
         * Each rotation is represented by a window
         * of length n in doubled string.
         */
        for (int start = 0; start < n; start++) {

            int left = 2 * start + 1;
            int right = 2 * (start + n - 1) + 1;

            int low = 1;
            int high = n;
            int best = 1;

            // Binary search for maximum palindrome length
            while (low <= high) {

                int mid = (low + high) / 2;

                /*
                 * A palindrome of length mid must have
                 * its center inside this range.
                 */
                int centerLeft = left + mid - 1;
                int centerRight = right - mid + 1;

                if (centerLeft <= centerRight) {

                    int maxRadius =
                            query(centerLeft, centerRight);

                    if (maxRadius >= mid) {
                        best = mid;
                        low = mid + 1;
                    } else {
                        high = mid - 1;
                    }

                } else {
                    high = mid - 1;
                }
            }

            answer.append(best).append('\n');
        }

        System.out.print(answer);
    }
}
